{
  "name": "pulsesocial-orchestrator",
  "version": "2.0.0",
  "description": "PulseSocial Background Publishing & Sync Worker",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" dotenv -e ../../.env -- nest start --watch --entryFile=./apps/orchestrator/src/main",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" NODE_ENV=production nest build",
    "start": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" dotenv -e ../../.env -- node --experimental-require-module ./dist/apps/orchestrator/src/main.js",
    "pm2": "pm2 start pnpm --name orchestrator -- start"
  },
